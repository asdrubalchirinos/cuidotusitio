---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Problema from '../components/Problema.astro';
import QueHago from '../components/QueHago.astro';
import Precio from '../components/Precio.astro';
import Como from '../components/Como.astro';
import Quien from '../components/Quien.astro';
import Faq from '../components/Faq.astro';
import Cierre from '../components/Cierre.astro';
import Footer from '../components/Footer.astro';
import RevealScript from '../components/RevealScript.astro';
---

<BaseLayout>
  <main>
    <Header />
    <Hero />
    <Problema />
    <QueHago />
    <Precio />
    <Como />
    <Quien />
    <Faq />
    <Cierre />
    <Footer />
