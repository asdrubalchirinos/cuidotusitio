---
import GlobeSimple from 'phosphor-astro/GlobeSimple.astro';
import WhatsappLogo from 'phosphor-astro/WhatsappLogo.astro';
import { whatsappUrl } from '../data/contact';
---

<footer class="site-footer">
  <div>
    <a href="/#problema">El problema</a>
    <a href="/#que-hago">Qué hago</a>
    <a href="/#precio">Precio</a>
    <a href="/#faq">FAQ</a>
  </div>
  <div>
    <a
      class="footer-icon-link"
      href="https://www.achirinos.com/"
      rel="noopener noreferrer"
      target="_blank"
    >
      <GlobeSimple width="16" height="16" aria-hidden="true" />
      <span>achirinos.com</span>
    </a>
    <a class="footer-icon-link" href={whatsappUrl()} rel="noopener noreferrer" target="_blank">
      <WhatsappLogo width="16" height="16" aria-hidden="true" />
      <span>WhatsApp</span>
    </a>
  </div>
  <div class="site-footer-meta">
    <p>
      <a href="/privacidad">Aviso de privacidad</a>
    </p>
    <p>© 2026 Asdrubal Chirinos · Cuido tu Sitio · Aguascalientes</p>
  </div>
</footer>
