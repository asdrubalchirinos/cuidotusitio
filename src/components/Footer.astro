---
import EnvelopeSimple from 'phosphor-astro/EnvelopeSimple.astro';
import GlobeSimple from 'phosphor-astro/GlobeSimple.astro';
import WhatsappLogo from 'phosphor-astro/WhatsappLogo.astro';
import XLogo from 'phosphor-astro/XLogo.astro';
import { EMAIL, whatsappUrl } from '../data/contact';
---

<footer class="site-footer">
  <nav class="footer-nav" aria-label="Secciones">
    <a href="/#problema">El problema</a>
    <a href="/#que-hago">Qué hago</a>
    <a href="/#precio">Precio</a>
    <a href="/#faq">FAQ</a>
  </nav>
  <nav class="footer-contact" aria-label="Contacto">
    <a class="footer-icon-link" href={whatsappUrl()} rel="noopener noreferrer" target="_blank">
      <WhatsappLogo width="16" height="16" aria-hidden="true" />
      <span>WhatsApp</span>
    </a>
    <a class="footer-icon-link" href={`mailto:${EMAIL}`}>
      <EnvelopeSimple width="16" height="16" aria-hidden="true" />
      <span>{EMAIL}</span>
    </a>
    <a
      class="footer-icon-link"
      href="https://www.achirinos.com/"
      rel="noopener noreferrer"
      target="_blank"
    >
      <GlobeSimple width="16" height="16" aria-hidden="true" />
      <span>achirinos.com</span>
    </a>
    <a
      class="footer-icon-link"
      href="https://x.com/achirinos"
      rel="noopener noreferrer"
      target="_blank"
    >
      <XLogo width="16" height="16" aria-hidden="true" />
      <span>@achirinos</span>
    </a>
  </nav>
  <div class="site-footer-meta">
    <p>
      <a href="/privacidad">Aviso de privacidad</a>
    </p>
    <p>© 2026 Cuido tu Sitio · Aguascalientes, México</p>
  </div>
</footer>
