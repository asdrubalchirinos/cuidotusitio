---
import { whatsappUrl } from '../data/contact';
---

<section class="hero reveal">
  <h1>cuido tu sitio</h1>
  <p class="tagline">Usted se dedica a su negocio. Yo cuido su sitio web.</p>
  <p class="lede">
    Mantenimiento mensual para sitios WordPress de consultorios, clínicas e inmobiliarias en
    Aguascalientes.
  </p>
  <p class="cta">
    <a
      class="btn-whatsapp"
      href={whatsappUrl('Hola, me interesa una revisión gratis de mi sitio.')}
      rel="noopener noreferrer"
      target="_blank">Pida su revisión gratis por WhatsApp</a
    >
  </p>
</section>
